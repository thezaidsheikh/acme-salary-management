DATABASE_URL="postgresql://acme:acme_dev@localhost:5432/salary_management"
PORT=4000
FRONTEND_URL=http://localhost:3000
# Seed-on-start (free-tier workaround for Render, which has no Shell):
# when "true", the backend seeds itself once on boot if the employees
# table is empty (skips at 10,000, refuses any other non-zero count).
# Leave "false" locally — run `npm run seed` by hand instead.
SEED_ON_START=false
